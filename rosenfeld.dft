(functional rosenfeld
  (dimension 3)

  (species
    (rho 0.5))

  (weighted-densities
    (n0  (fmt-weighted-density scalar-0))
    (n1  (fmt-weighted-density scalar-1))
    (n2  (fmt-weighted-density scalar-2))
    (n3  (fmt-weighted-density scalar-3))
    (nv1 (fmt-weighted-density vector-1))
    (nv2 (fmt-weighted-density vector-2)))

  (free-energy-density	       
    (let
      ((one-minus-n3
         (- 1 n3))

       (second-numerator
         (- (* n1 n2)
            (dot nv1 nv2)))

       (third-numerator
         (- (pow n2 3)
            (* 3 n2 (dot nv2 nv2)))))

      (+
        (* -1 n0 (log one-minus-n3))

        (/ second-numerator
           one-minus-n3)

        (/ third-numerator
           (* 24 pi (pow one-minus-n3 2)))))))